---
const destination = "https://coderiff.net/blog/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={destination} />
    <title>Diego Martin's blog</title>
  </head>
  <body>
    <p>Taking you to <a href={destination}>Diego's blog</a>.</p>
    <script>window.location.replace("https://coderiff.net/blog/");</script>
  </body>
</html>
